# Generated by init-sh from nascarsayan/box-config. Edit the template, not this file.
# Machine-specific additions go in ~/.config/zsh/zshrc.d/*.zsh (environment in
# zshenv.d/), which survive re-rendering.

{% include "../zsh/instant-prompt.zsh" %}
export POWERLEVEL10K_DISABLE_CONFIGURATION_WIZARD=1

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ ! -r "${ZINIT_HOME}/zinit.zsh" ]]; then
  print -u2 "init-sh: zinit is missing at ${ZINIT_HOME}"
  return 1
fi
source "${ZINIT_HOME}/zinit.zsh"

# Turbo-load network plugins after the first prompt. Keep syntax highlighting
# synchronous because it needs ZLE state during startup.
zinit ice depth=1
zinit load romkatv/powerlevel10k
zinit ice wait"0" lucid; zinit snippet OMZ::plugins/git/git.plugin.zsh
zinit ice wait"0" lucid; zinit snippet OMZ::plugins/sudo/sudo.plugin.zsh
zinit ice wait"0" lucid; zinit snippet OMZ::plugins/colored-man-pages/colored-man-pages.plugin.zsh
zinit ice wait"0" lucid; zinit snippet OMZ::plugins/kubectl/kubectl.plugin.zsh
zinit ice wait"0" lucid; zinit snippet OMZ::plugins/docker/docker.plugin.zsh
zinit ice wait"0" lucid; zinit snippet OMZ::plugins/docker-compose/docker-compose.plugin.zsh
zinit ice wait"0" lucid; zinit snippet OMZ::plugins/helm/helm.plugin.zsh
zinit ice wait"0" lucid; zinit snippet OMZ::plugins/git-extras/git-extras.plugin.zsh
zinit ice wait"0" lucid; zinit snippet https://raw.githubusercontent.com/ahmetb/kubectl-aliases/master/.kubectl_aliases
# atload: bind the widgets now; otherwise hints start only after the first command.
zinit ice wait"0" lucid atload"_zsh_autosuggest_start"; zinit load zsh-users/zsh-autosuggestions
zinit ice wait"0" lucid blockf; zinit load zsh-users/zsh-completions
zinit load zsh-users/zsh-syntax-highlighting

HISTFILE="${HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY APPEND_HISTORY INC_APPEND_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS HIST_FIND_NO_DUPS HIST_REDUCE_BLANKS

# Delay process-spawning integrations until zsh draws the first prompt.
_init_sh_deferred=0
_init_sh_defer() {
  (( _init_sh_deferred )) && return
  _init_sh_deferred=1
  command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
  command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
  command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"
  command -v broot >/dev/null 2>&1 && eval "$(broot --print-shell-function zsh)"
  add-zsh-hook -d precmd _init_sh_defer
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _init_sh_defer

# compinit with a dump that is rebuilt once a day: -C alone trusts the dump
# forever, so completions added later stay invisible.
ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-${HOST}-${ZSH_VERSION}"
[[ -d ${ZSH_COMPDUMP:h} ]] || mkdir -p ${ZSH_COMPDUMP:h}
autoload -Uz compinit
if [[ -n ${ZSH_COMPDUMP}(#qN.mh+24) || ! -s ${ZSH_COMPDUMP} ]]; then
  compinit -d "$ZSH_COMPDUMP"
else
  compinit -C -d "$ZSH_COMPDUMP"
fi
autoload -U +X bashcompinit && bashcompinit

{% include "../zsh/zshrc-body.zsh" %}

[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/init-sh/p10k.zsh" ]] && \
  source "${XDG_CONFIG_HOME:-$HOME/.config}/init-sh/p10k.zsh"

for _init_sh_rc in "${INIT_SH_ZSH_DIR:-$HOME/.config/zsh}"/zshrc.d/*.zsh(N); do
  source "$_init_sh_rc"
done
unset _init_sh_rc
